    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "jsdom": "^27.0.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  }
